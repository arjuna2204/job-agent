{
  "manifest_version": 3,
  "name": "Job Agent Autofill",
  "version": "0.1.0",
  "description": "Opens the jobs you approved on Job Agent and fills Greenhouse, Lever and Ashby applications from your saved answers.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Job Agent" },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["filler.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
